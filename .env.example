# Copy to .env.local and fill in. Never commit real secrets.

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Dev auth bypass (optional) ───────────────────────────────────────────────
# When 'true' (and NODE_ENV != production) the app skips login and runs as owner.
DEV_BYPASS_AUTH=false

# ── Reminder email digest (optional) ─────────────────────────────────────────
# The endpoint /api/cron/reminder-digest emails owners the reminders due today.
# Without RESEND_API_KEY it runs as a dry-run (computes + returns the digest,
# sends nothing). To send for real:
#   1. Create a Resend account + API key, verify a sending domain.
#   2. Set the two vars below.
#   3. Set CRON_SECRET and schedule a daily GET to the endpoint with header
#      `Authorization: Bearer <CRON_SECRET>` (Supabase pg_cron, Vercel Cron, …).
RESEND_API_KEY=
REMINDER_FROM_EMAIL="FrontierOS <reminders@yourdomain.com>"
CRON_SECRET=
