# Supabase — copy to .env.local and fill from your project
# (Project Settings → API). .env.local is gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── Dev auth bypass (optional) ──────────────────────────────────────────────
# Skip login during local development. Active ONLY when NODE_ENV != production,
# so it can never engage in a real build/deploy. The app renders as `owner`.
# Requires the service key below so data reads bypass RLS without a session.
# DEV_BYPASS_AUTH=true
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-OR-SECRET-KEY   # server-only, never expose
